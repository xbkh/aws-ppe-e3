{
  "DistributionConfig": {
    "CallerReference": "<UNE_VALEUR_UNIQUE>",
    "Comment": "ppe-e3 site vitrine",
    "Enabled": true,
    "DefaultRootObject": "index.html",
    "PriceClass": "PriceClass_100",
    "HttpVersion": "http2and3",
    "IsIPV6Enabled": true,
    "Origins": {
      "Quantity": 1,
      "Items": [{
        "Id": "s3-ppe-e3",
        "DomainName": "<NOM_DU_BUCKET>.s3.eu-central-2.amazonaws.com",
        "OriginAccessControlId": "<ID_OAC>",
        "S3OriginConfig": { "OriginAccessIdentity": "" }
      }]
    },
    "DefaultCacheBehavior": {
      "TargetOriginId": "s3-ppe-e3",
      "ViewerProtocolPolicy": "redirect-to-https",
      "AllowedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"], "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] } },
      "Compress": true,
      "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6"
    },
    "CustomErrorResponses": {
      "Quantity": 2,
      "Items": [
        { "ErrorCode": 403, "ResponsePagePath": "/error.html", "ResponseCode": "404", "ErrorCachingMinTTL": 60 },
        { "ErrorCode": 404, "ResponsePagePath": "/error.html", "ResponseCode": "404", "ErrorCachingMinTTL": 60 }
      ]
    },
    "ViewerCertificate": { "CloudFrontDefaultCertificate": true, "MinimumProtocolVersion": "TLSv1" }
  },
  "Tags": { "Items": [{ "Key": "Projet", "Value": "ppe-e3" }] }
}
